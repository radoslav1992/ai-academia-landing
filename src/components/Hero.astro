---
import { Image } from 'astro:assets';
import lecturerPhoto from '../assets/lecturer-photo.png';
import { LECTURER } from '../data/content';
---

<section class="hero" id="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-badge">
        <span class="hero-dot" aria-hidden="true"></span>
        Напълно безплатно · На живо в София
      </p>
      <h1 class="hero-title">
        Създавай с изкуствен интелект неща,<br />
        които доскоро изглеждаха <em>невъзможни</em>.
      </h1>
      <p class="hero-lead">
        Три безплатни курса на живо в София. Ще се научиш да създаваш сайтове и
        софтуер, изображения и видео и съдържание за социалните мрежи — с помощта
        на изкуствен интелект. Без такси и без условия: записваш се, а датата,
        часът и мястото идват на имейла ти.
      </p>
      <div class="hero-actions">
        <button type="button" class="btn btn-accent hero-primary" data-open-modal>
          Избери своя курс
        </button>
        <a href="#lecturer" class="btn btn-ghost hero-secondary">
          Запознай се с лектора
        </a>
      </div>
      <dl class="hero-stats">
        <div>
          <dt>3</dt>
          <dd>безплатни програми</dd>
        </div>
        <div>
          <dt>0 лв.</dt>
          <dd>винаги</dd>
        </div>
        <div>
          <dt>София</dt>
          <dd>на живо · скоро онлайн</dd>
        </div>
      </dl>
    </div>

    <div class="hero-media">
      <div class="hero-media-offset" aria-hidden="true"></div>
      <div class="hero-media-frame">
        <Image
          src={lecturerPhoto}
          alt={`${LECTURER.name} — лектор в AI Академия`}
          width={620}
          height={670}
          widths={[420, 620, 840]}
          sizes="(max-width: 920px) 100vw, 460px"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      </div>
      <div class="hero-chip">
        <span class="chip-badge" aria-hidden="true">10%</span>
        <span class="chip-text">
          <strong>Топ 10% в Lovable.dev</strong>
          <small>AI приложения &amp; vibe-coding</small>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 64px 40px;
    position: relative;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--badge-bg);
    color: var(--badge-ink);
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .hero-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2.6rem, 4.6vw, 4.1rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 22px 0 0;
  }
  .hero-title em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 540px;
    margin: 22px 0 0;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .hero-primary {
    padding: 16px 30px;
    font-size: 16px;
  }
  .hero-secondary {
    padding: 16px 26px;
    font-size: 16px;
    font-weight: 600;
  }

  .hero-stats {
    display: flex;
    gap: 32px;
    margin: 44px 0 0;
    flex-wrap: wrap;
  }
  .hero-stats div {
    display: flex;
    flex-direction: column;
  }
  .hero-stats dt {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 26px;
  }
  .hero-stats dd {
    margin: 0;
    font-size: 13px;
    color: var(--muted-2);
  }

  /* media column */
  .hero-media {
    position: relative;
  }
  .hero-media-offset {
    position: absolute;
    inset: 18px -18px -18px 18px;
    background: var(--accent);
    border-radius: 28px;
    z-index: 0;
  }
  .hero-media-frame {
    position: relative;
    z-index: 1;
    border-radius: 28px;
    overflow: hidden;
    transform: rotate(-1.2deg);
    box-shadow: 0 30px 50px rgba(28, 26, 22, 0.18);
  }
  .hero-img {
    display: block;
    width: 100%;
    height: 520px;
    object-fit: cover;
    object-position: center top;
  }
  .hero-chip {
    position: absolute;
    left: -18px;
    bottom: -22px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 10px 16px;
    box-shadow: 0 14px 30px rgba(28, 26, 22, 0.16);
  }
  .chip-badge {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: conic-gradient(from 180deg, #ff7a59, #7c5cff, #ff7a59);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 800;
    font-size: 11px;
    flex-shrink: 0;
  }
  .chip-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .chip-text strong {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .chip-text small {
    font-size: 11px;
    font-weight: 500;
    color: var(--muted-2);
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 64px;
    }
    .hero-media {
      max-width: 460px;
      margin-inline: auto;
      width: 100%;
    }
    .hero-img {
      height: 440px;
    }
  }
  @media (max-width: 520px) {
    .hero {
      padding-top: 40px;
    }
    .hero-img {
      height: 380px;
    }
  }
</style>

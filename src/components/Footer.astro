---
import { COURSES, courseAnchorId } from '../data/content';
import { SITE, ROUTES } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo">AI Академия</span>
        <p>Безплатни AI курсове на живо в София. Без такси и без условия.</p>
      </div>

      <div class="footer-col">
        <span class="footer-title">Курсове</span>
        <nav aria-label="Курсове">
          {
            COURSES.map((course) => (
              <a href={`${ROUTES.home}#${courseAnchorId(course.id)}`}>{course.title}</a>
            ))
          }
        </nav>
      </div>

      <div class="footer-col">
        <span class="footer-title">За нас</span>
        <nav aria-label="За нас">
          <a href={`${ROUTES.home}#lecturer`}>За лектора</a>
          <a href={`${ROUTES.home}#faq`}>Често задавани въпроси</a>
        </nav>
      </div>

      <div class="footer-col">
        <span class="footer-title">Правна информация</span>
        <nav aria-label="Правна информация">
          <a href={ROUTES.terms}>Общи условия</a>
          <a href={ROUTES.privacy}>Политика за поверителност</a>
          <a href={ROUTES.cookies}>Политика за бисквитки</a>
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 AI Академия · {SITE.owner}. Всички права запазени.</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--panel);
    padding: 64px 0 32px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }
  .footer-logo {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 22px;
  }
  .footer-brand p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted-2);
    margin: 12px 0 0;
    max-width: 260px;
  }
  .footer-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .footer-col nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 14px;
  }
  .footer-col a {
    font-size: 14px;
    color: var(--muted-2);
    text-decoration: none;
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    border-top: 1px solid var(--line-strong);
    margin-top: 44px;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-bottom span,
  .footer-bottom a {
    font-size: 13px;
    color: var(--muted-3);
    text-decoration: none;
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 460px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
